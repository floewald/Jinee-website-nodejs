{
  "video_id": "euvDjOD29Ng",
  "segment_count": 177,
  "segments": [
    {
      "start": 0.36,
      "duration": 3.32,
      "text": "你之前一天几百封的电邮进来"
    },
    {
      "start": 3.68,
      "duration": 3.0,
      "text": "但是现在完全是不一样的一个光景"
    },
    {
      "start": 6.68,
      "duration": 0.76,
      "text": "你原本很忙"
    },
    {
      "start": 7.44,
      "duration": 2.32,
      "text": "然后第二天    你突然就退休了"
    },
    {
      "start": 9.76,
      "duration": 2.76,
      "text": "你醒来    手机什么都没有"
    },
    {
      "start": 12.52,
      "duration": 2.0,
      "text": "你不再是那个有身份的人"
    },
    {
      "start": 14.52,
      "duration": 1.16,
      "text": "你变成了一个无名小卒"
    },
    {
      "start": 15.68,
      "duration": 3.2,
      "text": "然后你开始想    接下来该做什么"
    },
    {
      "start": 18.88,
      "duration": 1.4,
      "text": "我当时其实很迷茫"
    },
    {
      "start": 23.64,
      "duration": 0.88,
      "text": "每天早上醒来"
    },
    {
      "start": 24.52,
      "duration": 2.92,
      "text": "我的手机上都会有不少的工作讯息"
    },
    {
      "start": 27.44,
      "duration": 2.12,
      "text": "如果有一天突然没有人找我了"
    },
    {
      "start": 29.56,
      "duration": 2.76,
      "text": "我是会开心还是会失落"
    },
    {
      "start": 32.32,
      "duration": 1.64,
      "text": "今年64岁的许德平"
    },
    {
      "start": 33.96,
      "duration": 1.92,
      "text": "曾经是跨国企业的高管"
    },
    {
      "start": 35.88,
      "duration": 1.64,
      "text": "管理过1500人"
    },
    {
      "start": 37.52,
      "duration": 3.32,
      "text": "在海外五个国家工作超过20年"
    },
    {
      "start": 40.84,
      "duration": 2.4,
      "text": "那今天我们就来和他聊一聊"
    },
    {
      "start": 43.24,
      "duration": 1.96,
      "text": "退休生活对他而言"
    },
    {
      "start": 45.2,
      "duration": 1.4,
      "text": "是如释重负"
    },
    {
      "start": 46.6,
      "duration": 2.08,
      "text": "还是茫然若失"
    },
    {
      "start": 52.72,
      "duration": 4.8,
      "text": "我最后一份全职工作    我担任营运总监"
    },
    {
      "start": 57.52,
      "duration": 3.0,
      "text": "我在海外生活了22年多"
    },
    {
      "start": 60.52,
      "duration": 2.64,
      "text": "公司派我去的第一个国家是柬埔寨"
    },
    {
      "start": 64.0,
      "duration": 2.08,
      "text": "然后去缅甸"
    },
    {
      "start": 66.08,
      "duration": 2.36,
      "text": "巴布亚新几内亚    菲律宾"
    },
    {
      "start": 68.44,
      "duration": 1.28,
      "text": "再到蒙古"
    },
    {
      "start": 69.72,
      "duration": 2.6,
      "text": "当时去到那边的情况是怎样的"
    },
    {
      "start": 72.32,
      "duration": 1.28,
      "text": "我做的第一件事"
    },
    {
      "start": 73.6,
      "duration": 4.04,
      "text": "就是先为家人找一个可以一起住的家"
    },
    {
      "start": 77.64,
      "duration": 3.72,
      "text": "你会希望确保    已经为孩子们准备好"
    },
    {
      "start": 81.36,
      "duration": 2.64,
      "text": "一个可以成长    安心生活的家"
    },
    {
      "start": 84.0,
      "duration": 2.16,
      "text": "你每天的工作情况是怎样"
    },
    {
      "start": 86.16,
      "duration": 1.48,
      "text": "公司其实规模很大"
    },
    {
      "start": 87.64,
      "duration": 2.64,
      "text": "我实际上负责大约六个业务部门"
    },
    {
      "start": 90.28,
      "duration": 2.4,
      "text": "我们大约有1500名员工"
    },
    {
      "start": 92.68,
      "duration": 1.28,
      "text": "在那些时候"
    },
    {
      "start": 93.96,
      "duration": 2.88,
      "text": "你有足够的时间跟家人在一起吗"
    },
    {
      "start": 96.84,
      "duration": 2.68,
      "text": "我年轻的时候    工时非常长"
    },
    {
      "start": 99.52,
      "duration": 3.44,
      "text": "我通常要到晚上8点    9点回家"
    },
    {
      "start": 102.96,
      "duration": 1.48,
      "text": "有时候甚至10点才回来"
    },
    {
      "start": 104.44,
      "duration": 1.64,
      "text": "但那个时候    孩子们都已经睡着"
    },
    {
      "start": 106.08,
      "duration": 0.76,
      "text": "当你去上班的时候"
    },
    {
      "start": 106.84,
      "duration": 1.72,
      "text": "孩子们可能才刚起床"
    },
    {
      "start": 108.56,
      "duration": 2.08,
      "text": "等你回到家    他们又准备睡觉"
    },
    {
      "start": 110.64,
      "duration": 2.2,
      "text": "有一段时间    情况糟糕到这种程度"
    },
    {
      "start": 112.84,
      "duration": 2.68,
      "text": "我儿子当时大概只有三四岁"
    },
    {
      "start": 115.52,
      "duration": 1.92,
      "text": "睡在我的床上"
    },
    {
      "start": 117.44,
      "duration": 1.68,
      "text": "我回到家躺下睡觉时"
    },
    {
      "start": 119.12,
      "duration": 1.72,
      "text": "他一直把我踢下床"
    },
    {
      "start": 120.84,
      "duration": 2.12,
      "text": "因为他没有把我当成他的爸爸"
    },
    {
      "start": 122.96,
      "duration": 1.48,
      "text": "而是把我当成一个陌生人"
    },
    {
      "start": 124.44,
      "duration": 0.76,
      "text": "我的天"
    },
    {
      "start": 125.2,
      "duration": 0.64,
      "text": "是的    情况真的很糟"
    },
    {
      "start": 125.84,
      "duration": 1.64,
      "text": "这给了我一个当头棒喝"
    },
    {
      "start": 128.28,
      "duration": 1.76,
      "text": "你有做什么改变吗"
    },
    {
      "start": 130.04,
      "duration": 5.16,
      "text": "我开始陪他玩模型车和遥控车"
    },
    {
      "start": 135.2,
      "duration": 3.0,
      "text": "我开始和他一起玩遥控飞机"
    },
    {
      "start": 138.2,
      "duration": 1.2,
      "text": "他很喜欢"
    },
    {
      "start": 139.4,
      "duration": 2.08,
      "text": "因为他飞得非常好    比我还厉害"
    },
    {
      "start": 141.48,
      "duration": 2.28,
      "text": "后来    我们的关系变得越来越亲近"
    },
    {
      "start": 143.76,
      "duration": 2.28,
      "text": "那是一个非常重要的转折"
    },
    {
      "start": 146.04,
      "duration": 1.76,
      "text": "所以今天我感到非常开心"
    },
    {
      "start": 147.8,
      "duration": 3.56,
      "text": "我和儿子    女儿关系很亲近"
    },
    {
      "start": 151.96,
      "duration": 1.52,
      "text": "听了许德平这些年的故事"
    },
    {
      "start": 153.48,
      "duration": 2.96,
      "text": "真的是很感动于他的投入和执着"
    },
    {
      "start": 156.44,
      "duration": 1.56,
      "text": "我想也正是因为这样"
    },
    {
      "start": 158.0,
      "duration": 2.16,
      "text": "当他回到新加坡退休之后"
    },
    {
      "start": 160.16,
      "duration": 2.48,
      "text": "那几百封电邮突然消失不见"
    },
    {
      "start": 162.64,
      "duration": 2.08,
      "text": "也再没有1000多人来询问他"
    },
    {
      "start": 164.72,
      "duration": 1.56,
      "text": "有关工作的问题"
    },
    {
      "start": 166.28,
      "duration": 2.44,
      "text": "那种落差究竟有多大"
    },
    {
      "start": 168.72,
      "duration": 3.32,
      "text": "当我们一直以来被某个职位所定义着"
    },
    {
      "start": 172.04,
      "duration": 1.88,
      "text": "这个角色被拿走之后"
    },
    {
      "start": 173.92,
      "duration": 1.68,
      "text": "剩下的又是谁"
    },
    {
      "start": 179.64,
      "duration": 1.64,
      "text": "以前工作的时候"
    },
    {
      "start": 181.28,
      "duration": 2.32,
      "text": "有没有设想过退休是怎样的"
    },
    {
      "start": 183.6,
      "duration": 0.96,
      "text": "我其实从来没有真正想过"
    },
    {
      "start": 184.56,
      "duration": 2.68,
      "text": "对我来说    退休一直都是一件很遥远的事"
    },
    {
      "start": 187.24,
      "duration": 1.04,
      "text": "你一直为它做准备"
    },
    {
      "start": 188.28,
      "duration": 1.92,
      "text": "但还没回过神来    就已经退休了"
    },
    {
      "start": 191.92,
      "duration": 1.2,
      "text": "退休之后"
    },
    {
      "start": 193.12,
      "duration": 1.2,
      "text": "这些信息    这些电邮"
    },
    {
      "start": 194.32,
      "duration": 1.08,
      "text": "突然都不见"
    },
    {
      "start": 195.4,
      "duration": 2.88,
      "text": "那么当时你的心情落差是怎么样的"
    },
    {
      "start": 198.28,
      "duration": 1.64,
      "text": "早上一起床"
    },
    {
      "start": 199.92,
      "duration": 1.72,
      "text": "你拿起手机    打开来看"
    },
    {
      "start": 201.64,
      "duration": 1.72,
      "text": "却发现什么都没有"
    },
    {
      "start": 203.36,
      "duration": 2.88,
      "text": "那是一种很空虚的感觉"
    },
    {
      "start": 206.24,
      "duration": 1.52,
      "text": "因为你意识到"
    },
    {
      "start": 207.76,
      "duration": 2.4,
      "text": "这些事情你已经做了好多年"
    },
    {
      "start": 210.16,
      "duration": 0.84,
      "text": "但退休之后"
    },
    {
      "start": 211.0,
      "duration": 1.2,
      "text": "你再也不会收到这些讯息"
    },
    {
      "start": 212.2,
      "duration": 1.04,
      "text": "剩下的只有空荡荡的感觉"
    },
    {
      "start": 213.24,
      "duration": 1.64,
      "text": "我每天到底该做什么"
    },
    {
      "start": 214.88,
      "duration": 4.08,
      "text": "没有目标    也没有方向"
    },
    {
      "start": 220.0,
      "duration": 1.32,
      "text": "离开公司以后"
    },
    {
      "start": 221.32,
      "duration": 2.24,
      "text": "那些工作上的责任结束了"
    },
    {
      "start": 223.56,
      "duration": 1.4,
      "text": "但许德平发现"
    },
    {
      "start": 224.96,
      "duration": 2.04,
      "text": "自己还是希望被需要"
    },
    {
      "start": 227.0,
      "duration": 1.0,
      "text": "对他来说"
    },
    {
      "start": 228.0,
      "duration": 4.2,
      "text": "社区    成为了他人生的下一个岗位"
    },
    {
      "start": 232.2,
      "duration": 1.0,
      "text": "那时候终于到了"
    },
    {
      "start": 233.2,
      "duration": 1.8,
      "text": "可以去做我真正想做的事情的时候"
    },
    {
      "start": 235.0,
      "duration": 2.72,
      "text": "所以    我做的其中一件事"
    },
    {
      "start": 237.72,
      "duration": 1.72,
      "text": "就是开始投入社区基层工作"
    },
    {
      "start": 240.2,
      "duration": 2.48,
      "text": "我会尝试把工作中的经验带到这里"
    },
    {
      "start": 242.68,
      "duration": 3.72,
      "text": "比如    如何和大量的人沟通"
    },
    {
      "start": 246.4,
      "duration": 1.56,
      "text": "或是在社区里与大家沟通"
    },
    {
      "start": 247.96,
      "duration": 2.2,
      "text": "确保每个人都有共识"
    },
    {
      "start": 250.16,
      "duration": 1.44,
      "text": "这和在公司里是一样的"
    },
    {
      "start": 251.6,
      "duration": 2.4,
      "text": "你会努力把大家凝聚在一起"
    },
    {
      "start": 255.56,
      "duration": 0.96,
      "text": "社区工作"
    },
    {
      "start": 256.52,
      "duration": 2.92,
      "text": "让他继续发挥过去累积的经验"
    },
    {
      "start": 259.44,
      "duration": 1.92,
      "text": "但真正让他慢下来的"
    },
    {
      "start": 261.36,
      "duration": 3.24,
      "text": "是另一个陪伴了他大半辈子的兴趣"
    },
    {
      "start": 264.6,
      "duration": 1.8,
      "text": "模型火车"
    },
    {
      "start": 266.4,
      "duration": 1.64,
      "text": "它像是一条轨道"
    },
    {
      "start": 268.04,
      "duration": 2.76,
      "text": "把过去的自己    和今天的自己"
    },
    {
      "start": 270.8,
      "duration": 2.0,
      "text": "重新连接起来"
    },
    {
      "start": 278.44,
      "duration": 1.64,
      "text": "在这里    你可以看到"
    },
    {
      "start": 280.08,
      "duration": 2.16,
      "text": "我们建造的这些设施"
    },
    {
      "start": 282.24,
      "duration": 1.28,
      "text": "这些都是你的“孩子”吗"
    },
    {
      "start": 283.52,
      "duration": 3.92,
      "text": "这其实是在模拟其中一个地铁站"
    },
    {
      "start": 287.44,
      "duration": 1.16,
      "text": "那些地铁列车"
    },
    {
      "start": 288.6,
      "duration": 2.12,
      "text": "都是从零开始亲手制作出来的"
    },
    {
      "start": 291.88,
      "duration": 0.92,
      "text": "这个火车模型"
    },
    {
      "start": 292.8,
      "duration": 2.28,
      "text": "对于你来讲    有什么特别意义"
    },
    {
      "start": 295.08,
      "duration": 2.24,
      "text": "让你对它有这么大的兴趣"
    },
    {
      "start": 297.32,
      "duration": 1.48,
      "text": "我两岁的时候"
    },
    {
      "start": 298.8,
      "duration": 2.04,
      "text": "就拥有我的第一套火车模型"
    },
    {
      "start": 300.84,
      "duration": 1.4,
      "text": "对    那已经是很久以前的事"
    },
    {
      "start": 302.24,
      "duration": 5.24,
      "text": "我猜我爸爸当时其实是买给他自己玩的"
    },
    {
      "start": 307.48,
      "duration": 2.52,
      "text": "后来才给我玩"
    },
    {
      "start": 310.0,
      "duration": 0.8,
      "text": "这些年以來"
    },
    {
      "start": 310.8,
      "duration": 1.96,
      "text": "我就开始收藏火车模型"
    },
    {
      "start": 316.92,
      "duration": 2.6,
      "text": "有些兴趣    一个人可以坚持"
    },
    {
      "start": 319.52,
      "duration": 1.64,
      "text": "但有人一起分享"
    },
    {
      "start": 321.16,
      "duration": 2.52,
      "text": "它就会变成另一段人生"
    },
    {
      "start": 323.68,
      "duration": 1.44,
      "text": "回到新加坡之后"
    },
    {
      "start": 325.12,
      "duration": 2.12,
      "text": "许德平认识了 Thomas"
    },
    {
      "start": 327.24,
      "duration": 1.56,
      "text": "两个爱火车的人"
    },
    {
      "start": 328.8,
      "duration": 1.88,
      "text": "一起把小时候的兴趣"
    },
    {
      "start": 330.68,
      "duration": 2.64,
      "text": "变成共同努力的梦想"
    },
    {
      "start": 333.96,
      "duration": 2.84,
      "text": "我和 Thomas 都很热爱火车"
    },
    {
      "start": 336.8,
      "duration": 1.52,
      "text": "后来    我们一起参与了"
    },
    {
      "start": 338.32,
      "duration": 1.8,
      "text": "滨海湾花园的项目"
    },
    {
      "start": 345.56,
      "duration": 2.6,
      "text": "我们现在正在做的一件事"
    },
    {
      "start": 348.16,
      "duration": 2.52,
      "text": "就是思考如何把大家凝聚在一起"
    },
    {
      "start": 350.68,
      "duration": 1.8,
      "text": "我们知道我们需要一个新的场地"
    },
    {
      "start": 352.48,
      "duration": 1.84,
      "text": "来建设火车博物馆"
    },
    {
      "start": 354.32,
      "duration": 2.44,
      "text": "也作为模型铁路中心"
    },
    {
      "start": 356.76,
      "duration": 3.24,
      "text": "所以我们现在正积极寻找"
    },
    {
      "start": 360.0,
      "duration": 3.16,
      "text": "一个更大的场地"
    },
    {
      "start": 363.16,
      "duration": 1.12,
      "text": "然后    我们可以打造"
    },
    {
      "start": 364.28,
      "duration": 2.08,
      "text": "一个模型火车中心和博物馆"
    },
    {
      "start": 366.36,
      "duration": 2.88,
      "text": "让游客和火车爱好者都能来到这里"
    },
    {
      "start": 369.24,
      "duration": 2.16,
      "text": "彼此交流    聚在一起"
    },
    {
      "start": 371.4,
      "duration": 3.24,
      "text": "这是一个适合全家人一起参与的中心"
    },
    {
      "start": 374.64,
      "duration": 2.0,
      "text": "我们所做的一件非常重要的事"
    },
    {
      "start": 376.64,
      "duration": 1.6,
      "text": "就是让这项兴趣真正活起来"
    },
    {
      "start": 378.24,
      "duration": 2.68,
      "text": "并让更多人都有机会接触到它"
    },
    {
      "start": 381.92,
      "duration": 1.36,
      "text": "从事新闻这个行业"
    },
    {
      "start": 383.28,
      "duration": 2.84,
      "text": "我们很习惯用身份来介绍一个人"
    },
    {
      "start": 386.12,
      "duration": 1.44,
      "text": "比如新闻主播"
    },
    {
      "start": 387.56,
      "duration": 1.44,
      "text": "比如公司的总监"
    },
    {
      "start": 389.0,
      "duration": 1.52,
      "text": "或是销售人员"
    },
    {
      "start": 390.52,
      "duration": 2.4,
      "text": "仿佛身份是一个人的全部"
    },
    {
      "start": 392.92,
      "duration": 1.88,
      "text": "但许德平让我思考"
    },
    {
      "start": 394.8,
      "duration": 1.6,
      "text": "当这些身份不在了"
    },
    {
      "start": 396.4,
      "duration": 2.8,
      "text": "我们要用什么来介绍自己呢"
    },
    {
      "start": 399.2,
      "duration": 2.12,
      "text": "也许    退休真正要面对的"
    },
    {
      "start": 401.32,
      "duration": 1.0,
      "text": "不是变老"
    },
    {
      "start": 402.32,
      "duration": 2.96,
      "text": "而是如何重新认识我们自己"
    },
    {
      "start": 405.28,
      "duration": 1.68,
      "text": "而这也让我好奇"
    },
    {
      "start": 406.96,
      "duration": 2.52,
      "text": "当轮到我退休的那一天"
    },
    {
      "start": 409.48,
      "duration": 2.68,
      "text": "我又要怎样来介绍自己呢"
    }
  ]
}