{
  "video_id": "x7U6OarM2vk",
  "segment_count": 183,
  "segments": [
    {
      "start": 0.0,
      "duration": 1.36,
      "text": "到了这个年纪"
    },
    {
      "start": 1.36,
      "duration": 3.8,
      "text": "您心底最大的恐惧是什么呢"
    },
    {
      "start": 5.16,
      "duration": 2.52,
      "text": "我有一阵子常常会做梦"
    },
    {
      "start": 7.68,
      "duration": 2.52,
      "text": "梦到在一个地方"
    },
    {
      "start": 10.2,
      "duration": 2.32,
      "text": "找不到出去的方向"
    },
    {
      "start": 12.52,
      "duration": 1.88,
      "text": "我最近就有朋友"
    },
    {
      "start": 14.4,
      "duration": 2.44,
      "text": "死在家里一个星期没有人发觉"
    },
    {
      "start": 16.84,
      "duration": 1.24,
      "text": "那你会害怕"
    },
    {
      "start": 18.08,
      "duration": 1.16,
      "text": "那怎么办呢"
    },
    {
      "start": 22.4,
      "duration": 3.48,
      "text": "退休这件事情    对我来说还很遥远"
    },
    {
      "start": 25.88,
      "duration": 1.08,
      "text": "但不知道为什么"
    },
    {
      "start": 26.96,
      "duration": 2.72,
      "text": "最近听到越来越多的人讨论它"
    },
    {
      "start": 29.68,
      "duration": 2.68,
      "text": "有人期待退休    有人害怕退休"
    },
    {
      "start": 32.36,
      "duration": 2.08,
      "text": "也有人根本不愿意退休"
    },
    {
      "start": 35.0,
      "duration": 1.92,
      "text": "陈保兴属于第三种"
    },
    {
      "start": 36.92,
      "duration": 2.6,
      "text": "六十四岁了    他还在一直往前跑"
    },
    {
      "start": 39.52,
      "duration": 2.36,
      "text": "今天就约了他一起聊一聊"
    },
    {
      "start": 44.44,
      "duration": 2.04,
      "text": "当我考到导游证之后"
    },
    {
      "start": 46.48,
      "duration": 2.24,
      "text": "其实我最想介绍的就是这个地方"
    },
    {
      "start": 48.72,
      "duration": 2.2,
      "text": "这个地方叫 Kampung Admiralty"
    },
    {
      "start": 50.92,
      "duration": 4.56,
      "text": "甘榜    在马来文就是一个互助的社区"
    },
    {
      "start": 55.48,
      "duration": 2.52,
      "text": "它不光是一个老人的地方"
    },
    {
      "start": 58.0,
      "duration": 1.96,
      "text": "它有看护    有医院"
    },
    {
      "start": 59.96,
      "duration": 2.8,
      "text": "它也有零售    餐饮    还有住宅"
    },
    {
      "start": 62.76,
      "duration": 1.64,
      "text": "全部集合在这个地方"
    },
    {
      "start": 64.4,
      "duration": 1.48,
      "text": "因为新加坡空间很小"
    },
    {
      "start": 65.88,
      "duration": 1.88,
      "text": "所以我觉得这是一个"
    },
    {
      "start": 67.76,
      "duration": 3.72,
      "text": "老人以后非常理想的居住地方"
    },
    {
      "start": 71.48,
      "duration": 2.4,
      "text": "也可能就是我以后要生活的地方"
    },
    {
      "start": 80.48,
      "duration": 2.4,
      "text": "保兴大哥    在你工作最巅峰的时候"
    },
    {
      "start": 82.88,
      "duration": 1.6,
      "text": "曾经想过退休吗"
    },
    {
      "start": 84.48,
      "duration": 0.92,
      "text": "其实没有"
    },
    {
      "start": 85.76,
      "duration": 2.36,
      "text": "我今年已经六十四岁"
    },
    {
      "start": 88.12,
      "duration": 2.68,
      "text": "说实在    我真的没有想到退休这回事"
    },
    {
      "start": 90.8,
      "duration": 1.84,
      "text": "就是很自然的一直工作"
    },
    {
      "start": 92.64,
      "duration": 2.0,
      "text": "工作到接近六十岁"
    },
    {
      "start": 95.12,
      "duration": 2.88,
      "text": "1996年跟着我哥哥"
    },
    {
      "start": 98.0,
      "duration": 3.32,
      "text": "去上海开设一个美食广场"
    },
    {
      "start": 101.32,
      "duration": 2.2,
      "text": "我是先从上海待了很多年"
    },
    {
      "start": 103.52,
      "duration": 2.28,
      "text": "然后去北京    再去重庆"
    },
    {
      "start": 105.8,
      "duration": 2.04,
      "text": "又去中国的东北"
    },
    {
      "start": 107.84,
      "duration": 1.44,
      "text": "每个地方都是新的体验"
    },
    {
      "start": 109.28,
      "duration": 1.4,
      "text": "那时就觉得"
    },
    {
      "start": 110.68,
      "duration": 1.08,
      "text": "中国这么大"
    },
    {
      "start": 111.76,
      "duration": 2.2,
      "text": "很多地方可以再去感受一下"
    },
    {
      "start": 113.96,
      "duration": 2.76,
      "text": "所以就真的没有想到说要回来"
    },
    {
      "start": 116.72,
      "duration": 1.6,
      "text": "为什么会停不下来呢"
    },
    {
      "start": 118.32,
      "duration": 2.12,
      "text": "世界这么大    我想去走走"
    },
    {
      "start": 124.12,
      "duration": 3.08,
      "text": "基本上我这一生就做过三个职业"
    },
    {
      "start": 127.2,
      "duration": 1.56,
      "text": "就是文字工作者"
    },
    {
      "start": 128.76,
      "duration": 2.08,
      "text": "发型师    还有餐饮管理"
    },
    {
      "start": 130.84,
      "duration": 2.6,
      "text": "我想退休之后可能就有机会"
    },
    {
      "start": 133.44,
      "duration": 3.16,
      "text": "去尝试之前没有办法做到的事情"
    },
    {
      "start": 137.2,
      "duration": 1.68,
      "text": "我非常鼓励年轻人"
    },
    {
      "start": 138.88,
      "duration": 3.24,
      "text": "趁年轻的时候去尝试不同的职业"
    },
    {
      "start": 142.12,
      "duration": 2.84,
      "text": "那你觉得这个世界可能不是那么单一"
    },
    {
      "start": 144.96,
      "duration": 2.88,
      "text": "我觉得对一个人的身心发展"
    },
    {
      "start": 147.84,
      "duration": 1.68,
      "text": "是非常好的"
    },
    {
      "start": 149.52,
      "duration": 3.16,
      "text": "有没有一个瞬间你突然意识到"
    },
    {
      "start": 152.68,
      "duration": 0.96,
      "text": "我老了"
    },
    {
      "start": 153.64,
      "duration": 1.6,
      "text": "有    当然有"
    },
    {
      "start": 155.24,
      "duration": 3.08,
      "text": "就是我六十三岁的时候    就是去年"
    },
    {
      "start": 158.32,
      "duration": 1.68,
      "text": "我去找工作"
    },
    {
      "start": 160.0,
      "duration": 2.52,
      "text": "我以为麦当劳是最简单的"
    },
    {
      "start": 162.52,
      "duration": 1.88,
      "text": "比如说你教我包个汉堡"
    },
    {
      "start": 164.4,
      "duration": 2.48,
      "text": "收拾一下桌子    那很简单"
    },
    {
      "start": 166.88,
      "duration": 1.64,
      "text": "殊不知我去的时候"
    },
    {
      "start": 168.52,
      "duration": 3.16,
      "text": "他就给了我一个最艰难的    在前台里面 "
    },
    {
      "start": 171.68,
      "duration": 2.72,
      "text": "把厨房来的一些内容给顾客"
    },
    {
      "start": 174.4,
      "duration": 2.16,
      "text": "还要点算对不对"
    },
    {
      "start": 176.56,
      "duration": 2.48,
      "text": "关键是他完全没有给我任何培训"
    },
    {
      "start": 179.04,
      "duration": 1.04,
      "text": "我就上岗"
    },
    {
      "start": 180.08,
      "duration": 2.84,
      "text": "只是有一个师姐带着我"
    },
    {
      "start": 182.92,
      "duration": 1.84,
      "text": "可是那个师姐也非常忙"
    },
    {
      "start": 184.76,
      "duration": 1.36,
      "text": "她就有点嫌弃"
    },
    {
      "start": 186.12,
      "duration": 1.8,
      "text": "怎么要带这个什么都不懂的人"
    },
    {
      "start": 187.92,
      "duration": 1.64,
      "text": "而且我有点慢"
    },
    {
      "start": 189.56,
      "duration": 3.32,
      "text": "那当下您的心情是大受打击吗"
    },
    {
      "start": 192.88,
      "duration": 0.68,
      "text": "对"
    },
    {
      "start": 193.56,
      "duration": 1.72,
      "text": "真的太大打击"
    },
    {
      "start": 195.28,
      "duration": 1.88,
      "text": "因为你以为是很简单的一件事情"
    },
    {
      "start": 197.16,
      "duration": 2.24,
      "text": "可是居然这么简单的事情"
    },
    {
      "start": 199.4,
      "duration": 1.32,
      "text": "你都不能胜任"
    },
    {
      "start": 200.72,
      "duration": 1.72,
      "text": "或者你没有办法去克服"
    },
    {
      "start": 202.44,
      "duration": 3.28,
      "text": "所以那一刹那    是有打击的"
    },
    {
      "start": 206.72,
      "duration": 2.76,
      "text": "我以为很简单的一个工作"
    },
    {
      "start": 209.48,
      "duration": 1.44,
      "text": "我原来一天都做不了"
    },
    {
      "start": 210.92,
      "duration": 1.72,
      "text": "我只做了四个小时"
    },
    {
      "start": 212.64,
      "duration": 1.12,
      "text": "我就赶快逃了"
    },
    {
      "start": 215.04,
      "duration": 3.08,
      "text": "每个人对于退休有不同的定义"
    },
    {
      "start": 218.12,
      "duration": 2.76,
      "text": "最直接的退休就是你不工作了"
    },
    {
      "start": 220.88,
      "duration": 1.52,
      "text": "你没有薪水了"
    },
    {
      "start": 222.4,
      "duration": 2.32,
      "text": "你就过老年生活"
    },
    {
      "start": 224.72,
      "duration": 1.48,
      "text": "你已经六十多岁了"
    },
    {
      "start": 226.2,
      "duration": 2.4,
      "text": "你的体力    智力    记忆力都会衰退"
    },
    {
      "start": 228.6,
      "duration": 2.08,
      "text": "这是你自己知道的"
    },
    {
      "start": 230.68,
      "duration": 3.4,
      "text": "所以    我就在学习我应该做什么"
    },
    {
      "start": 235.36,
      "duration": 2.56,
      "text": "陈保兴的这段话让我特别有感触"
    },
    {
      "start": 237.92,
      "duration": 1.08,
      "text": "我们往往觉得"
    },
    {
      "start": 239.0,
      "duration": 2.2,
      "text": "变老是很久以后的事"
    },
    {
      "start": 241.2,
      "duration": 2.56,
      "text": "但“老”常常是悄然而至"
    },
    {
      "start": 243.76,
      "duration": 1.28,
      "text": "就像他所说"
    },
    {
      "start": 245.04,
      "duration": 1.56,
      "text": "突然有一天意识到"
    },
    {
      "start": 246.6,
      "duration": 2.24,
      "text": "原来以前很简单的事"
    },
    {
      "start": 248.84,
      "duration": 1.76,
      "text": "现在却做不到了"
    },
    {
      "start": 255.12,
      "duration": 1.04,
      "text": "回来新加坡之后"
    },
    {
      "start": 256.16,
      "duration": 2.68,
      "text": "您面对的最大挑战是什么"
    },
    {
      "start": 258.84,
      "duration": 1.68,
      "text": "从中国回到新加坡来"
    },
    {
      "start": 260.52,
      "duration": 1.52,
      "text": "我就觉得说"
    },
    {
      "start": 262.04,
      "duration": 1.72,
      "text": "我其实并不了解新加坡"
    },
    {
      "start": 263.76,
      "duration": 1.52,
      "text": "新加坡进步太快"
    },
    {
      "start": 265.28,
      "duration": 1.96,
      "text": "我去考个导游执照"
    },
    {
      "start": 267.24,
      "duration": 3.08,
      "text": "借此机会更了解新加坡"
    },
    {
      "start": 270.32,
      "duration": 1.72,
      "text": "考到之后就有个想法"
    },
    {
      "start": 272.04,
      "duration": 1.88,
      "text": "我觉得新加坡的生活方式"
    },
    {
      "start": 273.92,
      "duration": 2.48,
      "text": "是很值得介绍给外国朋友的"
    },
    {
      "start": 277.8,
      "duration": 0.96,
      "text": "我回来的时候"
    },
    {
      "start": 278.76,
      "duration": 2.88,
      "text": "我觉得新加坡的社区    越来越完整"
    },
    {
      "start": 281.64,
      "duration": 2.64,
      "text": "这是我印象特别深的"
    },
    {
      "start": 284.28,
      "duration": 3.24,
      "text": "尤其是对我们快要快到六十多岁的人"
    },
    {
      "start": 287.52,
      "duration": 1.56,
      "text": "更能够体会到这些社区"
    },
    {
      "start": 289.08,
      "duration": 3.08,
      "text": "养老这方面的设备非常完整"
    },
    {
      "start": 293.32,
      "duration": 1.52,
      "text": "我觉得这个非常好"
    },
    {
      "start": 294.84,
      "duration": 1.92,
      "text": "（如果有）一些紧急事件"
    },
    {
      "start": 296.76,
      "duration": 2.12,
      "text": "在我们家里有一些警铃"
    },
    {
      "start": 298.88,
      "duration": 1.24,
      "text": "那你拉的时候"
    },
    {
      "start": 300.12,
      "duration": 2.04,
      "text": "这边就会出现你的单位"
    },
    {
      "start": 302.16,
      "duration": 3.04,
      "text": "人家看到这个之后    就打电话求助"
    },
    {
      "start": 310.04,
      "duration": 2.84,
      "text": "我的单位是老人公寓"
    },
    {
      "start": 312.88,
      "duration": 3.0,
      "text": "所以这边有扶手    这些措施 "
    },
    {
      "start": 315.88,
      "duration": 3.56,
      "text": "让你更能安全的居住"
    },
    {
      "start": 319.44,
      "duration": 1.4,
      "text": "到了这个年纪"
    },
    {
      "start": 320.84,
      "duration": 3.8,
      "text": "您心底最大的恐惧是什么呢"
    },
    {
      "start": 324.64,
      "duration": 2.2,
      "text": "现在最大的恐惧就是"
    },
    {
      "start": 326.84,
      "duration": 6.2,
      "text": "你怎样去面对和适应老化的问题"
    },
    {
      "start": 335.32,
      "duration": 0.8,
      "text": "我年轻的时候"
    },
    {
      "start": 336.12,
      "duration": 1.96,
      "text": "一路来的职业都太匆忙"
    },
    {
      "start": 338.08,
      "duration": 2.12,
      "text": "每天有很多事情要看"
    },
    {
      "start": 340.2,
      "duration": 1.84,
      "text": "每天都要学    要适应"
    },
    {
      "start": 342.04,
      "duration": 3.44,
      "text": "我就从来没有想过"
    },
    {
      "start": 345.48,
      "duration": 0.84,
      "text": "我老了怎么办"
    },
    {
      "start": 348.2,
      "duration": 2.2,
      "text": "我有一阵子常常会做梦"
    },
    {
      "start": 351.56,
      "duration": 2.68,
      "text": "梦到在一个地方"
    },
    {
      "start": 354.24,
      "duration": 1.8,
      "text": "可能是一个危楼"
    },
    {
      "start": 356.04,
      "duration": 1.72,
      "text": "可能是一个森林"
    },
    {
      "start": 357.76,
      "duration": 2.0,
      "text": "找不到出去的方向"
    },
    {
      "start": 359.76,
      "duration": 2.16,
      "text": "那电话就一直打不通"
    },
    {
      "start": 361.92,
      "duration": 1.28,
      "text": "所以我知道我内心"
    },
    {
      "start": 363.2,
      "duration": 2.16,
      "text": "是有恐惧跟压力的"
    },
    {
      "start": 366.24,
      "duration": 1.84,
      "text": "我最近就有朋友"
    },
    {
      "start": 368.08,
      "duration": 2.36,
      "text": "死在家里一个星期没有人发觉"
    },
    {
      "start": 370.44,
      "duration": 1.76,
      "text": "那你会害怕"
    },
    {
      "start": 372.2,
      "duration": 1.64,
      "text": "那怎么办呢"
    },
    {
      "start": 373.84,
      "duration": 2.72,
      "text": "会担心你终老的时候"
    },
    {
      "start": 376.56,
      "duration": 2.36,
      "text": "你出了意外    没有人发觉"
    },
    {
      "start": 384.44,
      "duration": 2.16,
      "text": "那接下来您有怎样的计划呢"
    },
    {
      "start": 386.6,
      "duration": 3.28,
      "text": "我想启动一个叫“蜗牛与黄鹂鸟”的计划"
    },
    {
      "start": 390.96,
      "duration": 2.92,
      "text": "就是老年人跟年轻人一起活动"
    },
    {
      "start": 393.88,
      "duration": 3.08,
      "text": "一起吃饭    一起聚会"
    },
    {
      "start": 396.96,
      "duration": 3.16,
      "text": "中心思想就是    这两个年龄层的人"
    },
    {
      "start": 400.12,
      "duration": 2.4,
      "text": "互相在一起    互相理解"
    },
    {
      "start": 402.52,
      "duration": 2.36,
      "text": "那今天我不称呼你是记者"
    },
    {
      "start": 404.88,
      "duration": 1.48,
      "text": "也不称呼你是导游"
    },
    {
      "start": 406.36,
      "duration": 1.92,
      "text": "也不说你是餐饮业者"
    },
    {
      "start": 408.28,
      "duration": 1.96,
      "text": "这些职位都抛开"
    },
    {
      "start": 410.24,
      "duration": 1.6,
      "text": "你到底是谁"
    },
    {
      "start": 413.72,
      "duration": 1.2,
      "text": "我觉得"
    },
    {
      "start": 414.92,
      "duration": 2.72,
      "text": "就是一个体验生活的人"
    },
    {
      "start": 417.64,
      "duration": 1.64,
      "text": "你要去面对老龄"
    },
    {
      "start": 419.28,
      "duration": 1.92,
      "text": "你会去学习这个东西"
    },
    {
      "start": 421.2,
      "duration": 1.92,
      "text": "所以你就是一个生活的体验者"
    },
    {
      "start": 426.44,
      "duration": 1.28,
      "text": "见到陈保兴之前"
    },
    {
      "start": 427.72,
      "duration": 1.0,
      "text": "我一直觉得"
    },
    {
      "start": 428.72,
      "duration": 2.48,
      "text": "退休就算不是彻底停下来"
    },
    {
      "start": 431.2,
      "duration": 1.72,
      "text": "也是会放慢节奏"
    },
    {
      "start": 432.92,
      "duration": 1.16,
      "text": "但采访他之后"
    },
    {
      "start": 434.08,
      "duration": 2.8,
      "text": "我发现有些人根本不会停"
    },
    {
      "start": 436.88,
      "duration": 1.88,
      "text": "而是开始以另一种方式"
    },
    {
      "start": 438.76,
      "duration": 2.28,
      "text": "继续认识这个世界"
    },
    {
      "start": 441.04,
      "duration": 2.2,
      "text": "也许退休真正要面对的"
    },
    {
      "start": 443.24,
      "duration": 1.36,
      "text": "从来不是年龄"
    },
    {
      "start": 444.6,
      "duration": 2.04,
      "text": "而是我们放慢脚步之后"
    },
    {
      "start": 446.64,
      "duration": 2.68,
      "text": "还想成为怎样的人"
    }
  ]
}